# Image untuk PENGEMBANGAN (bukan produksi).
# Source code di-mount dari host lewat docker-compose.yml, lalu dijalankan dengan hot reload.
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src

# Polling dibutuhkan agar perubahan file terdeteksi pada bind mount (Windows/macOS).
ENV DOTNET_USE_POLLING_FILE_WATCHER=true \
    DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

EXPOSE 8080

CMD ["dotnet", "watch", "run", "--project", "src/PresensiJamaah.Web", "--no-launch-profile"]
