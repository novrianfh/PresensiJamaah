@using PresensiJamaah.Application.Models
@model RekapViewModel
@{
    ViewData["Title"] = "Rekap Kehadiran";
    var rekap = Model.Rekap;
    var q = Model.Query;
}

<h1 class="h3 mb-3">Rekap Kehadiran</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-auto">
        <label for="periode" class="form-label">Periode</label>
        <select id="periode" name="periode" class="form-select">
            <option value="@RekapPeriode.Minggu" selected="@(q.Periode == RekapPeriode.Minggu)">Mingguan</option>
            <option value="@RekapPeriode.Bulan" selected="@(q.Periode == RekapPeriode.Bulan)">Bulanan</option>
            <option value="@RekapPeriode.Tahun" selected="@(q.Periode == RekapPeriode.Tahun)">Tahunan</option>
        </select>
    </div>
    <div class="col-sm-auto">
        <label for="tanggal" class="form-label">Tanggal acuan</label>
        <input id="tanggal" name="tanggal" type="date" class="form-control" value="@q.Tanggal.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-sm-auto">
        <label for="eventId" class="form-label">Event</label>
        <select id="eventId" name="eventId" class="form-select">
            <option value="">Semua event</option>
            @foreach (var e in Model.Events)
            {
                <option value="@e.Id" selected="@(q.EventId == e.Id)">@e.Nama</option>
            }
        </select>
    </div>
    <div class="col-sm-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Tampilkan</button>
        <a asp-action="Export" asp-route-periode="@q.Periode" asp-route-tanggal="@q.Tanggal.ToString("yyyy-MM-dd")"
           asp-route-eventId="@q.EventId" class="btn btn-outline-success">Ekspor Excel</a>
    </div>
</form>

<p class="text-muted">
    @rekap.Dari.ToString("dd-MM-yyyy") &ndash; @rekap.Sampai.ToString("dd-MM-yyyy")
    &middot; @(rekap.EventNama ?? "Semua event")
    &middot; @rekap.TotalKejadian kejadian sudah berlangsung
    &middot; jamaah aktif bila kehadiran &ge; @rekap.MinimalPersen.ToString("0.##")%
    (@rekap.JumlahAktif dari @rekap.Rows.Count jamaah)
</p>

@if (rekap.TotalKejadian == 0)
{
    <div class="alert alert-info">Belum ada kejadian event yang berlangsung pada periode ini, sehingga persentase belum dapat dihitung.</div>
}

@if (rekap.Rows.Count == 0)
{
    <p class="text-muted">Belum ada jamaah aktif.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Nomor</th>
                    <th>Nama</th>
                    <th class="text-end">Hadir</th>
                    <th class="text-end">Persentase</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{ var no = 1; }
                @foreach (var r in rekap.Rows)
                {
                    <tr>
                        <td>@(no++)</td>
                        <td>@r.NomorJamaah</td>
                        <td>@r.Nama</td>
                        <td class="text-end">@r.Hadir / @rekap.TotalKejadian</td>
                        <td class="text-end">@r.Persen.ToString("0.0")%</td>
                        <td>
                            @if (r.Aktif)
                            {
                                <span class="badge text-bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Tidak aktif</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
