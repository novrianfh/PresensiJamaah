@model PresensiJamaah.Application.Models.JamaahDto
@{
    ViewData["Title"] = Model.Nama;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Nama</h1>
    @if (Model.IsActive)
    {
        <span class="badge text-bg-success">Aktif</span>
    }
    else
    {
        <span class="badge text-bg-secondary">Nonaktif</span>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="row">
<div class="col-lg-7">
<dl class="row">
    <dt class="col-sm-4">Nomor Jamaah</dt>
    <dd class="col-sm-8"><code>@Model.NomorJamaah</code></dd>
    <dt class="col-sm-4">Nomor HP</dt>
    <dd class="col-sm-8">@Model.NomorHp</dd>
    <dt class="col-sm-4">Tanggal Lahir</dt>
    <dd class="col-sm-8">@Model.TanggalLahir.ToString("dd-MM-yyyy")</dd>
    <dt class="col-sm-4">Jenis Kelamin</dt>
    <dd class="col-sm-8">@Model.JenisKelamin.ToLabel()</dd>
    <dt class="col-sm-4">Alamat</dt>
    <dd class="col-sm-8">@Model.Alamat</dd>
</dl>
</div>
<div class="col-lg-5 text-center">
    <img src="@Url.Action("Qr", new { id = Model.Id })" alt="QR Code @Model.NomorJamaah"
         width="200" height="200" class="img-thumbnail mb-2" />
    <div><code>@Model.NomorJamaah</code></div>
    <a asp-action="Kartu" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-primary mt-2">Cetak Kartu</a>
</div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Ubah</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
    @if (Model.IsActive)
    {
        <form asp-action="Nonaktifkan" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Nonaktifkan jamaah ini? Data presensi tetap tersimpan.');">
            <button type="submit" class="btn btn-outline-danger">Nonaktifkan</button>
        </form>
    }
    else
    {
        <form asp-action="Aktifkan" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-success">Aktifkan</button>
        </form>
    }
</div>
