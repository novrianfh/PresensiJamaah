@model JamaahFormViewModel
@{
    ViewData["Title"] = "Ubah Jamaah";
}

<h1 class="h3 mb-3">Ubah Jamaah</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-7">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Simpan</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Batal</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
