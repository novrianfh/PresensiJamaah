@model EventDetailsViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = e.Nama;
}

<h1 class="h3 mb-3">@e.Nama</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<dl class="row col-lg-8">
    <dt class="col-sm-3">Deskripsi</dt>
    <dd class="col-sm-9">@(string.IsNullOrEmpty(e.Deskripsi) ? "-" : e.Deskripsi)</dd>
    <dt class="col-sm-3">Mulai</dt>
    <dd class="col-sm-9">@e.WaktuMulai.ToString("dd-MM-yyyy HH:mm")</dd>
    <dt class="col-sm-3">Selesai</dt>
    <dd class="col-sm-9">@e.WaktuSelesai.ToString("dd-MM-yyyy HH:mm")</dd>
    <dt class="col-sm-3">Pengulangan</dt>
    <dd class="col-sm-9">
        @e.Recurrence.ToLabel()
        @if (e.RecurrenceEndDate is { } end)
        {
            <span>sampai @end.ToString("dd-MM-yyyy")</span>
        }
        else if (e.Recurrence != PresensiJamaah.Domain.Enums.Recurrence.None)
        {
            <span>tanpa batas</span>
        }
    </dd>
</dl>

<h2 class="h5">Jadwal @Model.UpcomingDays hari ke depan</h2>
@if (Model.Upcoming.Count == 0)
{
    <p class="text-muted">Tidak ada jadwal dalam periode ini.</p>
}
else
{
    <ul class="list-group col-lg-6 mb-3">
        @foreach (var o in Model.Upcoming)
        {
            <li class="list-group-item">
                @o.Mulai.ToString("ddd, dd-MM-yyyy") &middot; @o.Mulai.ToString("HH:mm") &ndash; @o.Selesai.ToString("HH:mm")
            </li>
        }
    </ul>
}

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-primary">Ubah</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
    <form asp-action="Delete" asp-route-id="@e.Id" method="post"
          onsubmit="return confirm('Hapus event ini?');">
        <button type="submit" class="btn btn-outline-danger">Hapus</button>
    </form>
</div>
